# Data - never commit raw/processed data (can be large)
data/
*.parquet
*.csv
*.h5
*.feather

# Exceptions - small samples for reproducibility
!**/data/.gitkeep
!**/data/sample_*.parquet

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# uv — commit uv.lock for reproducibility, ignore the cache
.uv/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Secrets
.env
*.env
secrets.json

# Cache
.cache/
cache/
*.cache

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/
*.swp

# Quarto output
_site/
/.quarto/

# Private interview prep — not for publishing
interview_prep/
